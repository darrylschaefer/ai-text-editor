{
  "name": "ai-text-editor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "homepage": "./",
  "main": "electron/index.cjs",
  "author": "Darryl Schaefer <darrylwschaefer@gmail.com>",
  "description": "Open-source, AI-assisted word processor.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.tests.json --noEmit && tsc --project tsconfig.e2e.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "check:all": "npm run check && playwright test",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron": "concurrently -k \"npm run dev\" \"wait-on tcp:5173 && electron .\"",
    "pack": "npm run build && electron-builder --dir",
    "make": "npm run build && electron-builder",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:quick": "playwright test"
  },
  "build": {
    "appId": "aiTextEditor",
    "productName": "fthr",
    "artifactName": "${os}-${name}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "dmg": {
      "title": "${productName} ${version}",
      "icon": "public/fthr.icns"
    },
    "mac": {
      "icon": "public/fthr.icns"
    },
    "linux": {
      "target": [
        "tar.gz",
        "AppImage"
      ],
      "category": "Chat",
      "icon": "public/fthr-desktop.png"
    },
    "win": {
      "target": "NSIS",
      "icon": "public/favicon.ico"
    }
  },
  "dependencies": {
    "@carbon/icons-react": "^11.21.0",
    "@dqbd/tiktoken": "^1.0.2",
    "@lexical/code": "0.52.0",
    "@lexical/code-prism": "0.52.0",
    "@lexical/html": "0.52.0",
    "@lexical/link": "0.52.0",
    "@lexical/list": "0.52.0",
    "@lexical/markdown": "0.52.0",
    "@lexical/react": "0.52.0",
    "@lexical/rich-text": "0.52.0",
    "@lexical/selection": "0.52.0",
    "@lexical/table": "0.52.0",
    "@lexical/utils": "0.52.0",
    "@react-oauth/google": "^0.9.0",
    "bootstrap-icons": "^1.10.5",
    "docx": "9.13.0",
    "electron-is-dev": "^2.0.0",
    "electron-squirrel-startup": "^1.0.0",
    "electron-updater": "^5.3.0",
    "html2canvas": "^1.4.1",
    "i18next": "^22.4.11",
    "i18next-browser-languagedetector": "^7.0.1",
    "i18next-http-backend": "^2.1.1",
    "idb-keyval": "^6.2.1",
    "jspdf": "^2.5.1",
    "katex": "^0.16.4",
    "lexical": "0.52.0",
    "lodash": "^4.17.21",
    "match-sorter": "^6.3.1",
    "papaparse": "^5.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-faq-component": "^1.3.4",
    "react-i18next": "^12.2.0",
    "react-markdown": "^8.0.5",
    "react-quill": "^2.0.0",
    "react-router-dom": "^6.16.0",
    "react-scroll-to-bottom": "^4.2.0",
    "react-svg": "^16.1.16",
    "rehype-highlight": "^6.0.0",
    "rehype-katex": "^6.0.2",
    "remark-gfm": "^3.0.1",
    "remark-math": "^5.1.1",
    "uuid": "^9.0.0",
    "yjs": "^13.6.6",
    "zustand": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@swc/cli": "^0.3.9",
    "@swc/core": "^1.4.2",
    "@tailwindcss/typography": "^0.5.9",
    "@types/carbon__icons-react": "^11.20.0",
    "@types/lodash": "^4.14.192",
    "@types/papaparse": "^5.3.7",
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.10",
    "@types/react-scroll-to-bottom": "^4.2.0",
    "@types/uuid": "^9.0.1",
    "@vitejs/plugin-react-swc": "^3.0.0",
    "autoprefixer": "^10.4.13",
    "concurrently": "^8.0.1",
    "electron": "^23.2.0",
    "electron-builder": "^23.6.0",
    "jsdom": "30.1.3",
    "jszip": "3.10.1",
    "postcss": "^8.4.21",
    "serve": "14.2.6",
    "tailwindcss": "^3.2.7",
    "typescript": "5.9.3",
    "vite": "^4.1.0",
    "vite-plugin-top-level-await": "^1.3.0",
    "vite-plugin-wasm": "^3.2.2",
    "vitest": "3.2.7",
    "wait-on": "^7.0.1"
  },
  "optionalDependencies": {
    "@swc/core-darwin-arm64": "^1.4.2",
    "@swc/core-darwin-x64": "^1.4.2",
    "@swc/core-linux-arm-gnueabihf": "^1.4.2",
    "@swc/core-linux-arm64-gnu": "^1.4.2",
    "@swc/core-linux-arm64-musl": "^1.4.2",
    "@swc/core-linux-x64-gnu": "^1.4.2",
    "@swc/core-linux-x64-musl": "^1.4.2",
    "@swc/core-win32-arm64-msvc": "^1.4.2",
    "@swc/core-win32-ia32-msvc": "^1.4.2",
    "@swc/core-win32-x64-msvc": "^1.4.2"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.19.0 <12"
  }
}
